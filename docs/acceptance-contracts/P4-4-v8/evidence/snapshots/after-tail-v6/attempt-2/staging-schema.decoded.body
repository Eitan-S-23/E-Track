{"result":[{"results":[{"name":"idx_announcements_public","type":"index","sql":"CREATE INDEX idx_announcements_public\r\nON announcements(app_id, published, pinned, published_at, updated_at)"},{"name":"idx_audit_logs_actor_created_at","type":"index","sql":"CREATE INDEX idx_audit_logs_actor_created_at ON audit_logs(actor, created_at)"},{"name":"idx_audit_logs_created_at","type":"index","sql":"CREATE INDEX idx_audit_logs_created_at ON audit_logs(created_at)"},{"name":"idx_channel_history_channel_revision","type":"index","sql":"CREATE INDEX idx_channel_history_channel_revision ON channel_history(channel_id, revision)"},{"name":"idx_channel_history_release_created","type":"index","sql":"CREATE INDEX idx_channel_history_release_created ON channel_history(release_id, created_at)"},{"name":"idx_channels_lookup","type":"index","sql":"CREATE INDEX idx_channels_lookup ON channels(app_id, platform, name)"},{"name":"idx_firmware_channels_lookup","type":"index","sql":"CREATE INDEX idx_firmware_channels_lookup\r\n  ON \"firmware_channels_legacy\"(app_id, device_model, name)"},{"name":"idx_firmware_idempotency_retained","type":"index","sql":"CREATE INDEX idx_firmware_idempotency_retained ON firmware_admin_idempotency(retained_until)"},{"name":"idx_firmware_releases_app_model_state","type":"index","sql":"CREATE INDEX idx_firmware_releases_app_model_state\r\n  ON \"firmware_releases_legacy\"(app_id, device_model, state)"},{"name":"idx_firmware_releases_r2","type":"index","sql":"CREATE INDEX idx_firmware_releases_r2\r\n  ON \"firmware_releases_legacy\"(app_id, device_model, r2_state, archived)"},{"name":"idx_firmware_tombstone_expired","type":"index","sql":"CREATE INDEX idx_firmware_tombstone_expired ON firmware_admin_idempotency_tombstones(expired_at)"},{"name":"idx_firmware_v2_assets_release","type":"index","sql":"CREATE INDEX idx_firmware_v2_assets_release ON firmware_release_assets(release_id)"},{"name":"idx_firmware_v2_patch_base","type":"index","sql":"CREATE INDEX idx_firmware_v2_patch_base ON firmware_release_assets(base_image_sha256,kind,r2_state)"},{"name":"idx_patches_lookup","type":"index","sql":"CREATE INDEX idx_patches_lookup\r\n  ON patches(app_id, platform, to_release_id, from_version_code, old_sha256)"},{"name":"idx_release_assets_app_platform_type","type":"index","sql":"CREATE INDEX idx_release_assets_app_platform_type ON release_assets(app_id, platform, asset_type)"},{"name":"idx_release_assets_release_platform_type","type":"index","sql":"CREATE INDEX idx_release_assets_release_platform_type ON release_assets(release_id, platform, asset_type)"},{"name":"idx_releases_app_platform_state","type":"index","sql":"CREATE INDEX idx_releases_app_platform_state ON releases(app_id, platform, state)"},{"name":"sqlite_autoindex_announcements_1","type":"index","sql":null},{"name":"sqlite_autoindex_app_config_1","type":"index","sql":null},{"name":"sqlite_autoindex_apps_1","type":"index","sql":null},{"name":"sqlite_autoindex_audit_logs_1","type":"index","sql":null},{"name":"sqlite_autoindex_channel_history_1","type":"index","sql":null},{"name":"sqlite_autoindex_channel_history_2","type":"index","sql":null},{"name":"sqlite_autoindex_channels_1","type":"index","sql":null},{"name":"sqlite_autoindex_channels_2","type":"index","sql":null},{"name":"sqlite_autoindex_d1_migrations_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_admin_idempotency_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_admin_idempotency_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_admin_idempotency_tombstones_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_backfill_manifests_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_channels_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_channels_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_channels_legacy_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_channels_legacy_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_release_assets_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_release_assets_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_release_assets_3","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_release_assets_4","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_3","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_4","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_legacy_1","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_legacy_2","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_legacy_3","type":"index","sql":null},{"name":"sqlite_autoindex_firmware_releases_legacy_4","type":"index","sql":null},{"name":"sqlite_autoindex_patches_1","type":"index","sql":null},{"name":"sqlite_autoindex_patches_2","type":"index","sql":null},{"name":"sqlite_autoindex_release_assets_1","type":"index","sql":null},{"name":"sqlite_autoindex_release_assets_2","type":"index","sql":null},{"name":"sqlite_autoindex_release_assets_3","type":"index","sql":null},{"name":"sqlite_autoindex_releases_1","type":"index","sql":null},{"name":"sqlite_autoindex_releases_2","type":"index","sql":null},{"name":"sqlite_autoindex_releases_3","type":"index","sql":null},{"name":"sqlite_autoindex_releases_4","type":"index","sql":null},{"name":"_cf_KV","type":"table","sql":"CREATE TABLE _cf_KV (\n        key TEXT PRIMARY KEY,\n        value BLOB\n      ) WITHOUT ROWID"},{"name":"announcements","type":"table","sql":"CREATE TABLE announcements (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  title TEXT NOT NULL CHECK (length(title) BETWEEN 1 AND 120),\r\n  body TEXT NOT NULL CHECK (length(body) BETWEEN 1 AND 8000),\r\n  pinned INTEGER NOT NULL DEFAULT 0 CHECK (pinned IN (0, 1)),\r\n  published INTEGER NOT NULL DEFAULT 1 CHECK (published IN (0, 1)),\r\n  published_at TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE\r\n)"},{"name":"app_config","type":"table","sql":"CREATE TABLE app_config (\r\n  app_id TEXT PRIMARY KEY,\r\n  default_channel TEXT NOT NULL DEFAULT 'stable' CHECK (default_channel IN ('stable', 'beta')),\r\n  min_supported_client_version_code INTEGER NOT NULL DEFAULT 0 CHECK (min_supported_client_version_code >= 0),\r\n  emergency_manifest_url TEXT,\r\n  disable_all_latest INTEGER NOT NULL DEFAULT 0 CHECK (disable_all_latest IN (0, 1)),\r\n  disable_all_downloads INTEGER NOT NULL DEFAULT 0 CHECK (disable_all_downloads IN (0, 1)),\r\n  maintenance_message TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE\r\n)"},{"name":"apps","type":"table","sql":"CREATE TABLE apps (\r\n  id TEXT PRIMARY KEY,\r\n  name TEXT NOT NULL,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now'))\r\n)"},{"name":"audit_logs","type":"table","sql":"CREATE TABLE audit_logs (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT,\r\n  actor TEXT NOT NULL,\r\n  actor_type TEXT NOT NULL CHECK (actor_type IN ('ci', 'access', 'system', 'test')),\r\n  action TEXT NOT NULL,\r\n  target_type TEXT NOT NULL,\r\n  target_id TEXT,\r\n  request_id TEXT NOT NULL,\r\n  ip TEXT,\r\n  user_agent TEXT,\r\n  before_json TEXT,\r\n  after_json TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')), reason TEXT,\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE SET NULL\r\n)"},{"name":"channel_history","type":"table","sql":"CREATE TABLE channel_history (\r\n  id TEXT PRIMARY KEY,\r\n  channel_id TEXT NOT NULL,\r\n  release_id TEXT,\r\n  revision INTEGER NOT NULL CHECK (revision >= 0),\r\n  action TEXT NOT NULL CHECK (\r\n    action IN (\r\n      'publish',\r\n      'rollback',\r\n      'stop_latest',\r\n      'resume_latest',\r\n      'stop_downloads',\r\n      'resume_downloads',\r\n      'edit_notes'\r\n    )\r\n  ),\r\n  actor TEXT NOT NULL,\r\n  actor_type TEXT NOT NULL CHECK (actor_type IN ('ci', 'access', 'system', 'test')),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  request_id TEXT NOT NULL,\r\n  before_json TEXT NOT NULL,\r\n  after_json TEXT NOT NULL,\r\n  FOREIGN KEY (channel_id) REFERENCES channels(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE SET NULL,\r\n  UNIQUE (channel_id, revision)\r\n)"},{"name":"channels","type":"table","sql":"CREATE TABLE channels (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  platform TEXT NOT NULL CHECK (platform IN ('android', 'windows')),\r\n  name TEXT NOT NULL CHECK (name IN ('stable', 'beta')),\r\n  current_release_id TEXT,\r\n  revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0),\r\n  disable_latest INTEGER NOT NULL DEFAULT 0 CHECK (disable_latest IN (0, 1)),\r\n  disable_downloads INTEGER NOT NULL DEFAULT 0 CHECK (disable_downloads IN (0, 1)),\r\n  maintenance_admin_only INTEGER NOT NULL DEFAULT 0 CHECK (maintenance_admin_only IN (0, 1)),\r\n  maintenance_message TEXT,\r\n  last_action TEXT NOT NULL DEFAULT 'init' CHECK (\r\n    last_action IN (\r\n      'init',\r\n      'publish',\r\n      'rollback',\r\n      'stop_latest',\r\n      'resume_latest',\r\n      'stop_downloads',\r\n      'resume_downloads',\r\n      'edit_notes'\r\n    )\r\n  ),\r\n  last_actor TEXT,\r\n  last_actor_type TEXT CHECK (last_actor_type IS NULL OR last_actor_type IN ('ci', 'access', 'system', 'test')),\r\n  last_request_id TEXT,\r\n  last_before_json TEXT,\r\n  last_after_json TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (current_release_id) REFERENCES releases(id) ON DELETE SET NULL,\r\n  UNIQUE (app_id, platform, name)\r\n)"},{"name":"d1_migrations","type":"table","sql":"CREATE TABLE \"d1_migrations\"(\n\t\tid         INTEGER PRIMARY KEY AUTOINCREMENT,\n\t\tname       TEXT UNIQUE,\n\t\tapplied_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL\n)"},{"name":"firmware_admin_idempotency","type":"table","sql":"CREATE TABLE firmware_admin_idempotency (\r\n  actor_canonical TEXT NOT NULL CHECK (length(trim(actor_canonical)) > 0 AND actor_canonical = lower(trim(actor_canonical))),\r\n  idempotency_key TEXT NOT NULL CHECK (length(idempotency_key) = 36\r\n    AND substr(idempotency_key,9,1) = '-' AND substr(idempotency_key,14,1) = '-'\r\n    AND substr(idempotency_key,19,1) = '-' AND substr(idempotency_key,24,1) = '-'\r\n    AND substr(idempotency_key,15,1) = '4' AND substr(idempotency_key,20,1) IN ('8','9','a','b')\r\n    AND length(replace(idempotency_key,'-','')) = 32 AND replace(idempotency_key,'-','') NOT GLOB '*[^0-9a-f]*'),\r\n  fingerprint TEXT NOT NULL CHECK (length(fingerprint) = 64 AND fingerprint NOT GLOB '*[^0-9a-f]*'),\r\n  method TEXT NOT NULL CHECK (method = 'POST'),\r\n  canonical_path TEXT NOT NULL,\r\n  action TEXT NOT NULL CHECK (action IN ('disable','recovery-download')),\r\n  release_id TEXT NOT NULL REFERENCES firmware_releases(id),\r\n  state TEXT NOT NULL CHECK (state IN ('pending','completed')),\r\n  status_code INTEGER,\r\n  response_body_json TEXT,\r\n  request_id TEXT,\r\n  created_epoch_seconds INTEGER NOT NULL CHECK (typeof(created_epoch_seconds) = 'integer' AND created_epoch_seconds >= 0),\r\n  retained_until INTEGER NOT NULL CHECK (retained_until = created_epoch_seconds + 86400),\r\n  original_expires_at INTEGER,\r\n  -- Deferred self-reference permits pending only inside the atomic batch.\r\n  completed_state TEXT NOT NULL DEFAULT 'completed' CHECK (completed_state = 'completed'),\r\n  PRIMARY KEY (actor_canonical,idempotency_key),\r\n  UNIQUE (actor_canonical,idempotency_key,completed_state),\r\n  FOREIGN KEY (actor_canonical,idempotency_key,state)\r\n    REFERENCES firmware_admin_idempotency(actor_canonical,idempotency_key,completed_state)\r\n    DEFERRABLE INITIALLY DEFERRED,\r\n  CHECK (canonical_path = '/api/admin/firmware/releases/' || release_id || '/' || action),\r\n  CHECK (state <> 'completed' OR (status_code IS NOT NULL AND status_code = 200\r\n    AND response_body_json IS NOT NULL AND json_valid(response_body_json)\r\n    AND json_type(response_body_json) = 'object' AND request_id IS NOT NULL AND length(request_id) > 0\r\n    AND COALESCE(json_type(response_body_json,'$.requestId'),'missing') = 'text'\r\n    AND json_extract(response_body_json,'$.requestId') = request_id)),\r\n  CHECK ((action = 'disable' AND original_expires_at IS NULL)\r\n    OR (action = 'recovery-download' AND (state = 'pending'\r\n      OR (original_expires_at IS NOT NULL AND original_expires_at = created_epoch_seconds + 300))))\r\n)"},{"name":"firmware_admin_idempotency_tombstones","type":"table","sql":"CREATE TABLE firmware_admin_idempotency_tombstones (\r\n  actor_canonical TEXT NOT NULL CHECK (length(trim(actor_canonical)) > 0 AND actor_canonical = lower(trim(actor_canonical))),\r\n  idempotency_key TEXT NOT NULL CHECK (length(idempotency_key) = 36\r\n    AND substr(idempotency_key,9,1) = '-' AND substr(idempotency_key,14,1) = '-'\r\n    AND substr(idempotency_key,19,1) = '-' AND substr(idempotency_key,24,1) = '-'\r\n    AND substr(idempotency_key,15,1) = '4' AND substr(idempotency_key,20,1) IN ('8','9','a','b')\r\n    AND length(replace(idempotency_key,'-','')) = 32 AND replace(idempotency_key,'-','') NOT GLOB '*[^0-9a-f]*'),\r\n  fingerprint TEXT NOT NULL CHECK (length(fingerprint) = 64 AND fingerprint NOT GLOB '*[^0-9a-f]*'),\r\n  action TEXT NOT NULL CHECK (action IN ('disable','recovery-download')),\r\n  release_id TEXT NOT NULL REFERENCES firmware_releases(id),\r\n  expired_at INTEGER NOT NULL CHECK (typeof(expired_at) = 'integer' AND expired_at >= 86400),\r\n  tombstoned_at INTEGER NOT NULL CHECK (typeof(tombstoned_at) = 'integer' AND tombstoned_at >= expired_at),\r\n  PRIMARY KEY (actor_canonical,idempotency_key)\r\n)"},{"name":"firmware_backfill_manifests","type":"table","sql":"CREATE TABLE firmware_backfill_manifests (\r\n  release_id TEXT NOT NULL PRIMARY KEY REFERENCES firmware_releases(id),\r\n  manifest_sha256 TEXT NOT NULL CHECK (length(manifest_sha256) = 64 AND manifest_sha256 NOT GLOB '*[^0-9a-f]*'),\r\n  manifest_json TEXT NOT NULL CHECK (json_valid(manifest_json) AND json_type(manifest_json) = 'object'),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now'))\r\n)"},{"name":"firmware_channels","type":"table","sql":"CREATE TABLE firmware_channels (\r\n  id TEXT NOT NULL PRIMARY KEY,\r\n  app_id TEXT NOT NULL REFERENCES apps(id) ON DELETE CASCADE,\r\n  device_model TEXT NOT NULL CHECK (length(trim(device_model)) > 0),\r\n  name TEXT NOT NULL CHECK (name IN ('stable','beta')),\r\n  current_release_id TEXT REFERENCES firmware_releases(id) ON DELETE SET NULL,\r\n  -- This is an unresolved migration marker, never a second distribution source.\r\n  legacy_current_release_id TEXT REFERENCES firmware_releases_legacy(id),\r\n  revision INTEGER NOT NULL DEFAULT 0 CHECK (typeof(revision) = 'integer' AND revision >= 0),\r\n  disable_latest INTEGER NOT NULL DEFAULT 0 CHECK (disable_latest IN (0,1)),\r\n  disable_downloads INTEGER NOT NULL DEFAULT 0 CHECK (disable_downloads IN (0,1)),\r\n  maintenance_message TEXT,\r\n  last_action TEXT NOT NULL DEFAULT 'init' CHECK (last_action IN ('init','publish','retract','stop_latest','resume_latest','stop_downloads','resume_downloads')),\r\n  last_actor TEXT,\r\n  last_actor_type TEXT CHECK (last_actor_type IS NULL OR last_actor_type IN ('ci','access','system','test')),\r\n  last_request_id TEXT,\r\n  last_reason TEXT,\r\n  last_before_json TEXT,\r\n  last_after_json TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  CHECK (current_release_id IS NULL OR legacy_current_release_id IS NULL),\r\n  UNIQUE (app_id,device_model,name)\r\n)"},{"name":"firmware_channels_legacy","type":"table","sql":"CREATE TABLE \"firmware_channels_legacy\" (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  device_model TEXT NOT NULL,\r\n  name TEXT NOT NULL CHECK (name IN ('stable', 'beta')),\r\n  current_release_id TEXT,\r\n  revision INTEGER NOT NULL DEFAULT 0 CHECK (revision >= 0),\r\n  disable_latest INTEGER NOT NULL DEFAULT 0 CHECK (disable_latest IN (0, 1)),\r\n  disable_downloads INTEGER NOT NULL DEFAULT 0 CHECK (disable_downloads IN (0, 1)),\r\n  maintenance_message TEXT,\r\n  last_action TEXT NOT NULL DEFAULT 'init' CHECK (\r\n    last_action IN (\r\n      'init',\r\n      'publish',\r\n      'rollback',\r\n      'stop_latest',\r\n      'resume_latest',\r\n      'stop_downloads',\r\n      'resume_downloads'\r\n    )\r\n  ),\r\n  last_actor TEXT,\r\n  last_actor_type TEXT CHECK (last_actor_type IS NULL OR last_actor_type IN ('ci', 'access', 'system', 'test')),\r\n  last_request_id TEXT,\r\n  last_before_json TEXT,\r\n  last_after_json TEXT,\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (current_release_id) REFERENCES \"firmware_releases_legacy\"(id) ON DELETE SET NULL,\r\n  UNIQUE (app_id, device_model, name)\r\n)"},{"name":"firmware_release_assets","type":"table","sql":"CREATE TABLE firmware_release_assets (\r\n  id TEXT NOT NULL PRIMARY KEY CHECK (length(trim(id)) > 0),\r\n  release_id TEXT NOT NULL REFERENCES firmware_releases(id) ON DELETE CASCADE,\r\n  kind TEXT NOT NULL CHECK (kind IN ('full','patch','recovery')),\r\n  file_name TEXT NOT NULL CHECK (\r\n    length(file_name) BETWEEN 1 AND 128 AND length(trim(file_name)) > 0 AND file_name NOT IN ('.','..')\r\n    AND file_name NOT GLOB '*[^ -~]*' AND instr(file_name,'/') = 0\r\n    AND instr(file_name,char(92)) = 0 AND instr(file_name,char(0)) = 0\r\n  ),\r\n  sha256 TEXT NOT NULL CHECK (length(sha256) = 64 AND sha256 NOT GLOB '*[^0-9a-f]*'),\r\n  size_bytes INTEGER NOT NULL CHECK (typeof(size_bytes) = 'integer' AND size_bytes > 0),\r\n  r2_key TEXT,\r\n  r2_etag TEXT,\r\n  r2_state TEXT NOT NULL DEFAULT 'not_uploaded' CHECK (r2_state IN ('not_uploaded','available','archived','r2_deleted')),\r\n  github_url TEXT NOT NULL CHECK (length(trim(github_url)) > 0 AND instr(github_url,'/latest/download/') = 0),\r\n  base_image_sha256 TEXT NOT NULL DEFAULT '',\r\n  base_vcode INTEGER NOT NULL DEFAULT 0 CHECK (typeof(base_vcode) = 'integer'),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  CHECK ((kind = 'patch' AND length(base_image_sha256) = 64\r\n          AND base_image_sha256 NOT GLOB '*[^0-9a-f]*' AND base_vcode > 0)\r\n      OR (kind IN ('full','recovery') AND base_image_sha256 = '' AND base_vcode = 0)),\r\n  CHECK (r2_state <> 'available' OR (r2_key IS NOT NULL AND length(trim(r2_key)) > 0\r\n    AND r2_etag IS NOT NULL AND length(trim(r2_etag)) > 0)),\r\n  UNIQUE (release_id,kind,base_image_sha256),\r\n  UNIQUE (release_id,file_name),\r\n  UNIQUE (r2_key)\r\n)"},{"name":"firmware_releases","type":"table","sql":"CREATE TABLE firmware_releases (\r\n  id TEXT NOT NULL PRIMARY KEY CHECK (length(trim(id)) > 0),\r\n  app_id TEXT NOT NULL REFERENCES apps(id) ON DELETE CASCADE,\r\n  device_model TEXT NOT NULL CHECK (length(trim(device_model)) > 0),\r\n  version_name TEXT NOT NULL CHECK (length(trim(version_name)) > 0),\r\n  version_code INTEGER NOT NULL CHECK (typeof(version_code) = 'integer' AND version_code BETWEEN 0 AND 4294967295),\r\n  release_tag TEXT NOT NULL CHECK (length(trim(release_tag)) > 0),\r\n  commit_sha TEXT NOT NULL CHECK (length(commit_sha) = 40 AND commit_sha NOT GLOB '*[^0-9a-f]*'),\r\n  run_id TEXT NOT NULL CHECK (length(trim(run_id)) > 0),\r\n  state TEXT NOT NULL DEFAULT 'draft' CHECK (state IN ('draft','ready','disabled')),\r\n  release_notes TEXT NOT NULL DEFAULT '',\r\n  target_image_sha256 TEXT NOT NULL CHECK (length(target_image_sha256) = 64 AND target_image_sha256 NOT GLOB '*[^0-9a-f]*'),\r\n  hardware_rev INTEGER NOT NULL CHECK (typeof(hardware_rev) = 'integer' AND hardware_rev BETWEEN 0 AND 65535),\r\n  layout_id INTEGER NOT NULL CHECK (typeof(layout_id) = 'integer' AND layout_id BETWEEN 0 AND 255),\r\n  min_boot_version INTEGER NOT NULL CHECK (typeof(min_boot_version) = 'integer' AND min_boot_version BETWEEN 0 AND 255),\r\n  min_protocol_version INTEGER NOT NULL CHECK (typeof(min_protocol_version) = 'integer' AND min_protocol_version BETWEEN 0 AND 255),\r\n  target_hardware TEXT NOT NULL CHECK (length(trim(target_hardware)) > 0),\r\n  transport TEXT NOT NULL DEFAULT 'ble' CHECK (transport = 'ble'),\r\n  min_app_version_code INTEGER NOT NULL DEFAULT 0 CHECK (typeof(min_app_version_code) = 'integer' AND min_app_version_code BETWEEN 0 AND 2100000000),\r\n  archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0,1)),\r\n  registration_json TEXT CHECK (registration_json IS NULL OR (json_valid(registration_json) AND json_type(registration_json) = 'object')),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  UNIQUE (app_id,device_model,release_tag),\r\n  UNIQUE (app_id,device_model,version_code),\r\n  UNIQUE (app_id,device_model,run_id)\r\n)"},{"name":"firmware_releases_legacy","type":"table","sql":"CREATE TABLE \"firmware_releases_legacy\" (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  device_model TEXT NOT NULL,\r\n  version_name TEXT NOT NULL,\r\n  version_code INTEGER NOT NULL CHECK (version_code >= 0),\r\n  release_tag TEXT NOT NULL,\r\n  commit_sha TEXT NOT NULL,\r\n  run_id TEXT NOT NULL,\r\n  state TEXT NOT NULL DEFAULT 'candidate' CHECK (state IN ('candidate', 'disabled')),\r\n  release_notes TEXT NOT NULL DEFAULT '',\r\n  file_name TEXT NOT NULL,\r\n  sha256 TEXT NOT NULL CHECK (length(sha256) = 64),\r\n  size_bytes INTEGER NOT NULL CHECK (size_bytes > 0),\r\n  r2_key TEXT,\r\n  r2_state TEXT NOT NULL DEFAULT 'not_uploaded' CHECK (r2_state IN ('not_uploaded', 'available', 'r2_deleted', 'archived')),\r\n  github_url TEXT NOT NULL CHECK (instr(github_url, '/latest/download/') = 0),\r\n  target_hardware TEXT,\r\n  transport TEXT NOT NULL DEFAULT 'ble',\r\n  min_app_version_code INTEGER NOT NULL DEFAULT 0 CHECK (min_app_version_code >= 0),\r\n  archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  UNIQUE (app_id, device_model, release_tag),\r\n  UNIQUE (app_id, device_model, run_id),\r\n  UNIQUE (app_id, device_model, version_code)\r\n)"},{"name":"patches","type":"table","sql":"CREATE TABLE \"patches\" (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  platform TEXT NOT NULL CHECK (platform IN ('android', 'windows')),\r\n  to_release_id TEXT NOT NULL,\r\n  asset_id TEXT NOT NULL,\r\n  from_version_code INTEGER NOT NULL CHECK (from_version_code >= 0),\r\n  old_sha256 TEXT NOT NULL CHECK (length(old_sha256) = 64),\r\n  patch_format TEXT NOT NULL DEFAULT 'tracepatch' CHECK (patch_format IN ('tracepatch', 'vcdiff')),\r\n  patch_sha256 TEXT NOT NULL CHECK (length(patch_sha256) = 64),\r\n  patch_size_bytes INTEGER NOT NULL CHECK (patch_size_bytes > 0),\r\n  output_sha256 TEXT NOT NULL CHECK (length(output_sha256) = 64),\r\n  output_size_bytes INTEGER NOT NULL CHECK (output_size_bytes > 0),\r\n  disabled INTEGER NOT NULL DEFAULT 0 CHECK (disabled IN (0, 1)),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (to_release_id) REFERENCES releases(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (asset_id) REFERENCES release_assets(id) ON DELETE CASCADE,\r\n  UNIQUE (app_id, platform, to_release_id, from_version_code, old_sha256, patch_format)\r\n)"},{"name":"release_assets","type":"table","sql":"CREATE TABLE release_assets (\r\n  id TEXT PRIMARY KEY,\r\n  release_id TEXT NOT NULL,\r\n  app_id TEXT NOT NULL,\r\n  platform TEXT NOT NULL CHECK (platform IN ('android', 'windows')),\r\n  asset_type TEXT NOT NULL CHECK (asset_type IN ('apk', 'windows_zip', 'windows_exe', 'manifest', 'patch')),\r\n  file_name TEXT NOT NULL,\r\n  sha256 TEXT NOT NULL CHECK (length(sha256) = 64),\r\n  size_bytes INTEGER NOT NULL CHECK (size_bytes > 0),\r\n  r2_key TEXT,\r\n  r2_state TEXT NOT NULL DEFAULT 'not_uploaded' CHECK (r2_state IN ('not_uploaded', 'available', 'r2_deleted', 'archived')),\r\n  github_url TEXT NOT NULL CHECK (instr(github_url, '/latest/download/') = 0),\r\n  disabled INTEGER NOT NULL DEFAULT 0 CHECK (disabled IN (0, 1)),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (release_id) REFERENCES releases(id) ON DELETE CASCADE,\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  UNIQUE (release_id, platform, asset_type, file_name),\r\n  UNIQUE (app_id, platform, github_url)\r\n)"},{"name":"releases","type":"table","sql":"CREATE TABLE releases (\r\n  id TEXT PRIMARY KEY,\r\n  app_id TEXT NOT NULL,\r\n  platform TEXT NOT NULL CHECK (platform IN ('android', 'windows')),\r\n  version_name TEXT NOT NULL,\r\n  version_code INTEGER NOT NULL CHECK (version_code >= 0),\r\n  release_tag TEXT NOT NULL,\r\n  commit_sha TEXT NOT NULL,\r\n  run_id TEXT NOT NULL,\r\n  state TEXT NOT NULL DEFAULT 'candidate' CHECK (state IN ('candidate', 'disabled')),\r\n  payload_signature_json TEXT,\r\n  security_payload_json TEXT NOT NULL,\r\n  release_notes TEXT NOT NULL DEFAULT '',\r\n  min_client_version_code INTEGER NOT NULL DEFAULT 0 CHECK (min_client_version_code >= 0),\r\n  capabilities_json TEXT NOT NULL DEFAULT '[]',\r\n  archived INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1)),\r\n  fallback_only INTEGER NOT NULL DEFAULT 0 CHECK (fallback_only IN (0, 1)),\r\n  created_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  updated_at TEXT NOT NULL DEFAULT (datetime('now')),\r\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE CASCADE,\r\n  UNIQUE (app_id, platform, release_tag),\r\n  UNIQUE (app_id, platform, run_id),\r\n  UNIQUE (app_id, platform, version_code)\r\n)"},{"name":"sqlite_sequence","type":"table","sql":"CREATE TABLE sqlite_sequence(name,seq)"},{"name":"audit_logs_no_delete","type":"trigger","sql":"CREATE TRIGGER audit_logs_no_delete\r\nBEFORE DELETE ON audit_logs\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'audit_logs are append-only');\r\nEND"},{"name":"audit_logs_no_update","type":"trigger","sql":"CREATE TRIGGER audit_logs_no_update\r\nBEFORE UPDATE ON audit_logs\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'audit_logs are append-only');\r\nEND"},{"name":"channel_history_no_delete","type":"trigger","sql":"CREATE TRIGGER channel_history_no_delete\r\nBEFORE DELETE ON channel_history\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'channel_history is append-only');\r\nEND"},{"name":"channel_history_no_update","type":"trigger","sql":"CREATE TRIGGER channel_history_no_update\r\nBEFORE UPDATE ON channel_history\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'channel_history is append-only');\r\nEND"},{"name":"channels_append_history","type":"trigger","sql":"CREATE TRIGGER channels_append_history\r\nAFTER UPDATE OF current_release_id, revision, disable_latest, disable_downloads, maintenance_admin_only, maintenance_message ON channels\r\nWHEN NEW.revision > OLD.revision AND NEW.last_action <> 'init'\r\nBEGIN\r\n  INSERT INTO channel_history (\r\n    id,\r\n    channel_id,\r\n    release_id,\r\n    revision,\r\n    action,\r\n    actor,\r\n    actor_type,\r\n    request_id,\r\n    before_json,\r\n    after_json\r\n  )\r\n  VALUES (\r\n    'hist_' || lower(hex(randomblob(16))),\r\n    NEW.id,\r\n    NEW.current_release_id,\r\n    NEW.revision,\r\n    NEW.last_action,\r\n    COALESCE(NEW.last_actor, 'system'),\r\n    COALESCE(NEW.last_actor_type, 'system'),\r\n    COALESCE(NEW.last_request_id, 'unknown'),\r\n    COALESCE(NEW.last_before_json, '{}'),\r\n    COALESCE(NEW.last_after_json, '{}')\r\n  );\r\n\r\n  INSERT INTO audit_logs (\r\n    id,\r\n    app_id,\r\n    actor,\r\n    actor_type,\r\n    action,\r\n    target_type,\r\n    target_id,\r\n    request_id,\r\n    before_json,\r\n    after_json\r\n  )\r\n  VALUES (\r\n    'audit_' || lower(hex(randomblob(16))),\r\n    NEW.app_id,\r\n    COALESCE(NEW.last_actor, 'system'),\r\n    COALESCE(NEW.last_actor_type, 'system'),\r\n    NEW.last_action,\r\n    'channel',\r\n    NEW.id,\r\n    COALESCE(NEW.last_request_id, 'unknown'),\r\n    COALESCE(NEW.last_before_json, '{}'),\r\n    COALESCE(NEW.last_after_json, '{}')\r\n  );\r\nEND"},{"name":"channels_reject_disabled_release_insert","type":"trigger","sql":"CREATE TRIGGER channels_reject_disabled_release_insert\r\nBEFORE INSERT ON channels\r\nWHEN NEW.current_release_id IS NOT NULL\r\n  AND EXISTS (SELECT 1 FROM releases WHERE id = NEW.current_release_id AND state = 'disabled')\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'channel cannot point at disabled release');\r\nEND"},{"name":"channels_reject_disabled_release_update","type":"trigger","sql":"CREATE TRIGGER channels_reject_disabled_release_update\r\nBEFORE UPDATE OF current_release_id ON channels\r\nWHEN NEW.current_release_id IS NOT NULL\r\n  AND EXISTS (SELECT 1 FROM releases WHERE id = NEW.current_release_id AND state = 'disabled')\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'channel cannot point at disabled release');\r\nEND"},{"name":"firmware_asset_base_insert","type":"trigger","sql":"CREATE TRIGGER firmware_asset_base_insert BEFORE INSERT ON firmware_release_assets\r\nWHEN NEW.kind = 'patch' AND NOT EXISTS (\r\n  SELECT 1 FROM firmware_releases WHERE id = NEW.release_id AND version_code > NEW.base_vcode)\r\nBEGIN SELECT RAISE(ABORT,'firmware patch base version must precede target'); END"},{"name":"firmware_asset_identity","type":"trigger","sql":"CREATE TRIGGER firmware_asset_identity BEFORE UPDATE OF\r\n  id,release_id,kind,file_name,sha256,size_bytes,github_url,base_image_sha256,base_vcode,created_at ON firmware_release_assets\r\nBEGIN SELECT RAISE(ABORT,'firmware asset identity is immutable'); END"},{"name":"firmware_asset_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_asset_no_delete BEFORE DELETE ON firmware_release_assets\r\nBEGIN SELECT RAISE(ABORT,'firmware asset history is retained'); END"},{"name":"firmware_audit_reason","type":"trigger","sql":"CREATE TRIGGER firmware_audit_reason BEFORE INSERT ON audit_logs\r\nWHEN NEW.target_type IN ('firmware_release','firmware_asset','firmware_channel')\r\n  AND NEW.actor_type = 'access' AND (NEW.reason IS NULL OR length(trim(NEW.reason,char(9)||char(10)||char(11)||char(12)||char(13)||' ')) = 0)\r\nBEGIN SELECT RAISE(ABORT,'firmware admin reason required'); END"},{"name":"firmware_audit_values","type":"trigger","sql":"CREATE TRIGGER firmware_audit_values BEFORE INSERT ON audit_logs\r\nWHEN NEW.target_type IN ('firmware_release','firmware_asset','firmware_channel') AND (\r\n  NEW.id IS NULL OR length(trim(NEW.id)) = 0 OR length(trim(NEW.actor)) = 0\r\n  OR length(trim(NEW.request_id)) = 0 OR NEW.after_json IS NULL\r\n  OR NOT json_valid(NEW.after_json) OR json_type(NEW.after_json) <> 'object'\r\n  OR (NEW.before_json IS NOT NULL AND (NOT json_valid(NEW.before_json) OR json_type(NEW.before_json) <> 'object')))\r\nBEGIN SELECT RAISE(ABORT,'firmware audit identity and object snapshots required'); END"},{"name":"firmware_channel_audit","type":"trigger","sql":"CREATE TRIGGER firmware_channel_audit AFTER UPDATE ON firmware_channels\r\nWHEN NEW.revision <> OLD.revision\r\nBEGIN\r\n  INSERT INTO audit_logs(id,app_id,actor,actor_type,action,target_type,target_id,\r\n    request_id,reason,before_json,after_json)\r\n  VALUES ('audit_' || lower(hex(randomblob(16))),NEW.app_id,NEW.last_actor,\r\n    NEW.last_actor_type,NEW.last_action,'firmware_channel',NEW.id,\r\n    NEW.last_request_id,NEW.last_reason,NEW.last_before_json,NEW.last_after_json);\r\nEND"},{"name":"firmware_channel_identity","type":"trigger","sql":"CREATE TRIGGER firmware_channel_identity BEFORE UPDATE OF id,app_id,device_model,name,created_at ON firmware_channels\r\nBEGIN SELECT RAISE(ABORT,'firmware channel identity is immutable'); END"},{"name":"firmware_channel_mutation_guard","type":"trigger","sql":"CREATE TRIGGER firmware_channel_mutation_guard BEFORE UPDATE ON firmware_channels\r\nWHEN (NEW.current_release_id IS NOT OLD.current_release_id OR NEW.legacy_current_release_id IS NOT OLD.legacy_current_release_id\r\n  OR NEW.disable_latest <> OLD.disable_latest OR NEW.disable_downloads <> OLD.disable_downloads\r\n  OR NEW.maintenance_message IS NOT OLD.maintenance_message)\r\n  AND NEW.revision <> OLD.revision + 1\r\n  AND NOT (OLD.legacy_current_release_id IS NOT NULL AND NEW.current_release_id = OLD.legacy_current_release_id\r\n    AND NEW.legacy_current_release_id IS NULL AND NEW.revision = OLD.revision\r\n    AND NEW.disable_latest = OLD.disable_latest AND NEW.disable_downloads = OLD.disable_downloads\r\n    AND NEW.maintenance_message IS OLD.maintenance_message\r\n    AND EXISTS (SELECT 1 FROM firmware_backfill_manifests WHERE release_id=NEW.current_release_id))\r\nBEGIN SELECT RAISE(ABORT,'firmware channel mutation requires CAS revision'); END"},{"name":"firmware_channel_no_legacy_retarget","type":"trigger","sql":"CREATE TRIGGER firmware_channel_no_legacy_retarget BEFORE UPDATE OF legacy_current_release_id ON firmware_channels\r\nWHEN NEW.legacy_current_release_id IS NOT NULL AND NEW.legacy_current_release_id IS NOT OLD.legacy_current_release_id\r\nBEGIN SELECT RAISE(ABORT,'legacy channel retarget forbidden'); END"},{"name":"firmware_channel_no_new_legacy","type":"trigger","sql":"CREATE TRIGGER firmware_channel_no_new_legacy BEFORE INSERT ON firmware_channels\r\nWHEN NEW.legacy_current_release_id IS NOT NULL\r\nBEGIN SELECT RAISE(ABORT,'new legacy channel reference forbidden'); END"},{"name":"firmware_channel_revision","type":"trigger","sql":"CREATE TRIGGER firmware_channel_revision BEFORE UPDATE OF revision ON firmware_channels\r\nWHEN NEW.revision <> OLD.revision AND (NEW.revision <> OLD.revision + 1\r\n  OR NEW.last_actor IS NULL OR length(trim(NEW.last_actor)) = 0\r\n  OR NEW.last_actor_type IS NULL OR NEW.last_request_id IS NULL\r\n  OR NEW.last_reason IS NULL OR length(trim(NEW.last_reason)) = 0\r\n  OR NEW.last_before_json IS NULL OR NOT json_valid(NEW.last_before_json)\r\n  OR NEW.last_after_json IS NULL OR NOT json_valid(NEW.last_after_json))\r\nBEGIN SELECT RAISE(ABORT,'firmware mutation requires revision and audit context'); END"},{"name":"firmware_idempotency_delete_guard","type":"trigger","sql":"CREATE TRIGGER firmware_idempotency_delete_guard BEFORE DELETE ON firmware_admin_idempotency\r\nWHEN NOT EXISTS (SELECT 1 FROM firmware_admin_idempotency_tombstones t\r\n  WHERE t.actor_canonical = OLD.actor_canonical AND t.idempotency_key = OLD.idempotency_key\r\n    AND t.fingerprint = OLD.fingerprint AND t.action = OLD.action\r\n    AND t.release_id = OLD.release_id AND t.expired_at = OLD.retained_until)\r\nBEGIN SELECT RAISE(ABORT,'firmware result cleanup requires matching tombstone first'); END"},{"name":"firmware_idempotency_immutable","type":"trigger","sql":"CREATE TRIGGER firmware_idempotency_immutable BEFORE UPDATE ON firmware_admin_idempotency\r\nWHEN OLD.state = 'completed' OR NEW.state <> 'completed'\r\n  OR NEW.actor_canonical <> OLD.actor_canonical OR NEW.idempotency_key <> OLD.idempotency_key\r\n  OR NEW.fingerprint <> OLD.fingerprint OR NEW.method <> OLD.method OR NEW.canonical_path <> OLD.canonical_path\r\n  OR NEW.action <> OLD.action OR NEW.release_id <> OLD.release_id\r\n  OR NEW.created_epoch_seconds <> OLD.created_epoch_seconds OR NEW.retained_until <> OLD.retained_until\r\nBEGIN SELECT RAISE(ABORT,'firmware idempotency result is immutable'); END"},{"name":"firmware_idempotency_no_reuse","type":"trigger","sql":"CREATE TRIGGER firmware_idempotency_no_reuse BEFORE INSERT ON firmware_admin_idempotency\r\nWHEN EXISTS (SELECT 1 FROM firmware_admin_idempotency_tombstones\r\n  WHERE actor_canonical = NEW.actor_canonical AND idempotency_key = NEW.idempotency_key)\r\nBEGIN SELECT RAISE(ABORT,'firmware idempotency key is tombstoned'); END"},{"name":"firmware_idempotency_starts_pending","type":"trigger","sql":"CREATE TRIGGER firmware_idempotency_starts_pending BEFORE INSERT ON firmware_admin_idempotency\r\nWHEN NEW.state <> 'pending'\r\nBEGIN SELECT RAISE(ABORT,'firmware idempotency must reserve pending before completion'); END"},{"name":"firmware_legacy_channel_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_channel_no_delete BEFORE DELETE ON firmware_channels_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy channel is retained'); END"},{"name":"firmware_legacy_channel_no_insert","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_channel_no_insert BEFORE INSERT ON firmware_channels_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy channel is read only'); END"},{"name":"firmware_legacy_channel_no_update","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_channel_no_update BEFORE UPDATE ON firmware_channels_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy channel is read only'); END"},{"name":"firmware_legacy_release_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_release_no_delete BEFORE DELETE ON firmware_releases_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy firmware is retained'); END"},{"name":"firmware_legacy_release_no_insert","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_release_no_insert BEFORE INSERT ON firmware_releases_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy firmware is read only'); END"},{"name":"firmware_legacy_release_no_update","type":"trigger","sql":"CREATE TRIGGER firmware_legacy_release_no_update BEFORE UPDATE ON firmware_releases_legacy\r\nBEGIN SELECT RAISE(ABORT,'legacy firmware is read only'); END"},{"name":"firmware_manifest_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_manifest_no_delete BEFORE DELETE ON firmware_backfill_manifests\r\nBEGIN SELECT RAISE(ABORT,'firmware manifest is retained'); END"},{"name":"firmware_manifest_no_update","type":"trigger","sql":"CREATE TRIGGER firmware_manifest_no_update BEFORE UPDATE ON firmware_backfill_manifests\r\nBEGIN SELECT RAISE(ABORT,'firmware manifest is immutable'); END"},{"name":"firmware_pointer_insert","type":"trigger","sql":"CREATE TRIGGER firmware_pointer_insert BEFORE INSERT ON firmware_channels\r\nWHEN NEW.current_release_id IS NOT NULL AND NOT EXISTS (\r\n  SELECT 1 FROM firmware_releases r WHERE r.id = NEW.current_release_id\r\n    AND r.app_id = NEW.app_id AND r.device_model = NEW.device_model AND r.state = 'ready' AND r.archived = 0)\r\nBEGIN SELECT RAISE(ABORT,'firmware channel requires same-scope ready release'); END"},{"name":"firmware_pointer_update","type":"trigger","sql":"CREATE TRIGGER firmware_pointer_update BEFORE UPDATE OF current_release_id,app_id,device_model ON firmware_channels\r\nWHEN NEW.current_release_id IS NOT NULL AND NOT EXISTS (\r\n  SELECT 1 FROM firmware_releases r WHERE r.id = NEW.current_release_id\r\n    AND r.app_id = NEW.app_id AND r.device_model = NEW.device_model AND r.state = 'ready' AND r.archived = 0)\r\nBEGIN SELECT RAISE(ABORT,'firmware channel requires same-scope ready release'); END"},{"name":"firmware_publish_regression","type":"trigger","sql":"CREATE TRIGGER firmware_publish_regression BEFORE UPDATE OF current_release_id,revision ON firmware_channels\r\nWHEN NEW.revision <> OLD.revision AND NEW.last_action = 'publish'\r\n  AND (SELECT version_code FROM firmware_releases WHERE id = NEW.current_release_id)\r\n    <= COALESCE((SELECT version_code FROM firmware_releases WHERE id = OLD.current_release_id),\r\n      (SELECT version_code FROM firmware_releases_legacy WHERE id = OLD.legacy_current_release_id))\r\nBEGIN SELECT RAISE(ABORT,'firmware version regression'); END"},{"name":"firmware_r2_identity","type":"trigger","sql":"CREATE TRIGGER firmware_r2_identity BEFORE UPDATE OF r2_key,r2_etag ON firmware_release_assets\r\nWHEN (OLD.r2_key IS NOT NULL AND NEW.r2_key IS NOT OLD.r2_key)\r\n  OR (OLD.r2_etag IS NOT NULL AND NEW.r2_etag IS NOT OLD.r2_etag)\r\nBEGIN SELECT RAISE(ABORT,'verified firmware R2 identity is immutable'); END"},{"name":"firmware_ready_assets_sealed","type":"trigger","sql":"CREATE TRIGGER firmware_ready_assets_sealed BEFORE INSERT ON firmware_release_assets\r\nWHEN EXISTS (SELECT 1 FROM firmware_releases WHERE id=NEW.release_id AND state='ready')\r\nBEGIN SELECT RAISE(ABORT,'ready firmware asset set is sealed'); END"},{"name":"firmware_ready_insert","type":"trigger","sql":"CREATE TRIGGER firmware_ready_insert BEFORE INSERT ON firmware_releases\r\nWHEN NEW.state = 'ready'\r\nBEGIN SELECT RAISE(ABORT,'firmware ready requires draft assets'); END"},{"name":"firmware_ready_update","type":"trigger","sql":"CREATE TRIGGER firmware_ready_update BEFORE UPDATE OF state ON firmware_releases\r\nWHEN NEW.state = 'ready' AND (\r\n  (SELECT count(*) FROM firmware_release_assets WHERE release_id = NEW.id AND kind = 'full') <> 1\r\n  OR EXISTS (SELECT 1 FROM firmware_release_assets WHERE release_id = NEW.id\r\n    AND (r2_state <> 'available' OR r2_key IS NULL OR length(trim(r2_key)) = 0)))\r\nBEGIN SELECT RAISE(ABORT,'firmware ready requires exactly one full and verified assets'); END"},{"name":"firmware_release_identity","type":"trigger","sql":"CREATE TRIGGER firmware_release_identity BEFORE UPDATE OF\r\n  id,app_id,device_model,version_name,version_code,release_tag,commit_sha,run_id,\r\n  target_image_sha256,hardware_rev,layout_id,min_boot_version,min_protocol_version,\r\n  target_hardware,transport,min_app_version_code,registration_json,created_at ON firmware_releases\r\nBEGIN SELECT RAISE(ABORT,'firmware release identity is immutable'); END"},{"name":"firmware_release_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_release_no_delete BEFORE DELETE ON firmware_releases\r\nBEGIN SELECT RAISE(ABORT,'firmware release history is retained'); END"},{"name":"firmware_release_referenced","type":"trigger","sql":"CREATE TRIGGER firmware_release_referenced BEFORE UPDATE OF state,archived ON firmware_releases\r\nWHEN (NEW.state <> 'ready' OR NEW.archived = 1)\r\n  AND EXISTS (SELECT 1 FROM firmware_channels WHERE current_release_id = NEW.id)\r\nBEGIN SELECT RAISE(ABORT,'firmware release is in use'); END"},{"name":"firmware_state_transition","type":"trigger","sql":"CREATE TRIGGER firmware_state_transition BEFORE UPDATE OF state ON firmware_releases\r\nWHEN (OLD.state = 'disabled' AND NEW.state <> 'disabled')\r\n  OR (OLD.state = 'ready' AND NEW.state = 'draft')\r\nBEGIN SELECT RAISE(ABORT,'firmware release state transition forbidden'); END"},{"name":"firmware_tombstone_consistent","type":"trigger","sql":"CREATE TRIGGER firmware_tombstone_consistent BEFORE INSERT ON firmware_admin_idempotency_tombstones\r\nWHEN EXISTS (SELECT 1 FROM firmware_admin_idempotency_tombstones t\r\n  WHERE t.actor_canonical = NEW.actor_canonical AND t.idempotency_key = NEW.idempotency_key\r\n    AND (t.fingerprint <> NEW.fingerprint OR t.action <> NEW.action\r\n      OR t.release_id <> NEW.release_id OR t.expired_at <> NEW.expired_at))\r\n  OR EXISTS (SELECT 1 FROM firmware_admin_idempotency i\r\n  WHERE i.actor_canonical = NEW.actor_canonical AND i.idempotency_key = NEW.idempotency_key\r\n    AND (i.state <> 'completed' OR i.fingerprint <> NEW.fingerprint OR i.action <> NEW.action\r\n      OR i.release_id <> NEW.release_id OR i.retained_until <> NEW.expired_at))\r\nBEGIN SELECT RAISE(ABORT,'firmware tombstone integrity mismatch'); END"},{"name":"firmware_tombstone_no_delete","type":"trigger","sql":"CREATE TRIGGER firmware_tombstone_no_delete BEFORE DELETE ON firmware_admin_idempotency_tombstones\r\nBEGIN SELECT RAISE(ABORT,'firmware tombstone is permanent'); END"},{"name":"firmware_tombstone_no_update","type":"trigger","sql":"CREATE TRIGGER firmware_tombstone_no_update BEFORE UPDATE ON firmware_admin_idempotency_tombstones\r\nBEGIN SELECT RAISE(ABORT,'firmware tombstone is immutable'); END"},{"name":"releases_reject_disable_when_published","type":"trigger","sql":"CREATE TRIGGER releases_reject_disable_when_published\r\nBEFORE UPDATE OF state ON releases\r\nWHEN NEW.state = 'disabled'\r\n  AND EXISTS (SELECT 1 FROM channels WHERE current_release_id = NEW.id)\r\nBEGIN\r\n  SELECT RAISE(ABORT, 'published release cannot be disabled');\r\nEND"}],"success":true,"meta":{"served_by":"v3-prod","served_by_region":"WNAM","served_by_colo":"LAX","served_by_primary":true,"timings":{"sql_duration_ms":1.7157},"duration":1.7157,"changes":0,"last_row_id":0,"changed_db":false,"size_after":409600,"rows_read":240,"rows_written":0,"total_attempts":1}}],"errors":[],"messages":[],"success":true}