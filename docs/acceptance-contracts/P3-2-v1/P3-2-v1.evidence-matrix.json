    {
      "id": "CMD-BUILD-GCC-PRODUCTION",
      "command": "export SOURCE_DATE_EPOCH=1786320000 && LOG=docs/acceptance-contracts/P3-2-v1/commands/build-gcc-production.log && {\n  echo \"### 环境 ###\"\n  echo \"SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH\"\n  cmake --version | head -n 1\n  echo\n  echo \"### 1. configure ###\"\n  cmake -S MDK-ARM_F435/cmake-generated -B MDK-ARM_F435/cmake-generated/build-gcc-release -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_OBJECT_PATH_MAX=1024 2>&1 | tail -n 12\n  echo \"CONFIGURE_EXIT=${PIPESTATUS[0]}\"\n  echo\n  echo \"### 2. clean（强制全量重建）###\"\n  cmake --build MDK-ARM_F435/cmake-generated/build-gcc-release --target clean 2>&1 | tail -n 3\n  echo \"CLEAN_EXIT=${PIPESTATUS[0]}\"\n  echo\n  echo \"### 3. build X_Track_App_GCC + X_Track_Boot ###\"\n  cmake --build MDK-ARM_F435/cmake-generated/build-gcc-release --target X_Track_App_GCC X_Track_Boot --parallel 2>&1 | grep -viE \"wchar_t|^\\[[0-9]+/[0-9]+\\] (Building|Linking) \" | tail -n 40\n  echo \"BUILD_EXIT=${PIPESTATUS[0]}\"\n} > $LOG 2>&1; echo \"全量重建结束 rc=$?\"; tail -n 22 $LOG",
      "exit_code": 0,
      "output_evidence": "commands/build-gcc-production.log"
    },
    {
      "id": "CMD-BUILD-ARTIFACTS",
      "command": "B=docs/acceptance-contracts/P3-2-v1/commands && D=MDK-ARM_F435/cmake-generated/build-gcc-release && {\n  echo \"### 全量重建后产物指纹（第二次独立复现）###\"\n  for f in $D/app-gcc/X-Track-App-GCC.elf $D/app-gcc/X-Track-App-GCC.hex $D/app-gcc/X-Track-App-GCC.bin $D/app-gcc/X-Track-App-GCC.map $D/boot/X-Track-Boot.elf $D/boot/X-Track-Boot.hex $D/boot/X-Track-Boot.bin $D/boot/X-Track-Boot.map; do\n    printf \"%-52s %10s  %s  %s\\n\" \"$(basename $f)\" \"$(stat -c%s $f)\" \"$(date -r $f '+%Y-%m-%d %H:%M:%S')\" \"$(sha256sum $f | cut -c1-64)\"\n  done\n  echo\n  echo \"### arm-none-eabi-size 双目标 ###\"\n  \"D:/singlechip/gcc+gdb+openocd/tools/arm-gnu-toolchain-13.3.rel1-ming/bin/arm-none-eabi-size.exe\" $D/app-gcc/X-Track-App-GCC.elf $D/boot/X-Track-Boot.elf\n  echo\n  echo \"### 链接产物中确认 ota_device_info 参与链接 ###\"\n  grep -c \"ota_device_info.c.obj\" $D/build.ninja\n  ls -la $D/CMakeFiles/X_Track_App_GCC.dir/D_/github/my/E-Track/Libraries/OTA/ota_device_info.c.obj\n} > $B/build-artifacts.log 2>&1; cat $B/build-artifacts.log",
      "exit_code": 0,
      "output_evidence": "commands/build-artifacts.log"
    },
