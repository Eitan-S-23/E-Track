-    uint32_t start;
-
-    if (byte == NULL)
-    {
-        return -1;
-    }
-    start = boot_platform_millis();
-    while (usart_flag_get(UART5, USART_RDBF_FLAG) == RESET)
-    {
-        if ((uint32_t)(boot_platform_millis() - start) >= timeout_ms)
-        {
-            return -1;
-        }
-    }
-    *byte = (uint8_t)usart_data_receive(UART5);
