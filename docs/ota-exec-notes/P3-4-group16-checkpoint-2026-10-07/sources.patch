+    OTA_P1_6_CP_TRY_DECREMENT_COMMITTED = 9,
+    OTA_P1_6_CP_ROLLBACK_COMMITTED = 10,
+    OTA_P1_6_CP_ROLLBACK_CONFIRMED = 11,
