-    offset = 0u;
-    while (offset < len)
-    {
-        uint16_t left = len - offset;
-        uint16_t take = left < sizeof(verify) ? left : sizeof(verify);
-        if (boot_platform_eeprom_read((uint8_t)(address + offset), verify, take) != 0 ||
-            memcmp(verify, src + offset, take) != 0)
-        {
-            return -1;
-        }
-        offset += take;
-    }
-    return 0;
