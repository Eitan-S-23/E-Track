+enum
+{
+    OTA_P1_6_SLOT_CANDIDATE = 1,
+    OTA_P1_6_SLOT_BACKUP = 2,
+    OTA_P1_6_SLOT_RECOVERY = 4
+};
+
+enum
+{
+    OTA_P1_6_CP_CANDIDATE_VALIDATED = 1,
+    OTA_P1_6_CP_APPLYING_COMMITTED = 2,
+    OTA_P1_6_CP_COPY_BEFORE_ERASE = 3,
