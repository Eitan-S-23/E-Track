-    flash_unlock();
-    for (offset = 0u; offset < len; offset += 4u)
-    {
-        uint32_t word = (uint32_t)src[offset] |
-                        ((uint32_t)src[offset + 1u] << 8) |
-                        ((uint32_t)src[offset + 2u] << 16) |
