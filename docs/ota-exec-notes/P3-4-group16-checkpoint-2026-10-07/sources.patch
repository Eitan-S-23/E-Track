-int boot_platform_eeprom_write(uint8_t address, const uint8_t *src, uint16_t len)
-{
-    uint16_t offset = 0u;
-    uint8_t verify[16];
-
-    if ((src == NULL && len != 0u) || len == 0u ||
-        (uint16_t)address + len > BOOT_EEPROM_RESERVED_ADDR)
