        {
            "label": "Flash ST-Link ELF",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
                "-f",
                "target/artery/at32f4x.cfg",
                "-c",
                "program {${workspaceFolder}/build-gcc/X-Track.elf} verify reset exit"
            ],
            "dependsOn": "Build GCC Debug",
            "problemMatcher": []
        },
        {
            "label": "Flash ST-Link HEX",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "interface/stlink.cfg",
