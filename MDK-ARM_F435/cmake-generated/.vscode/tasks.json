{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure GCC Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-gcc",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build GCC Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-gcc",
                "--target",
                "X_Track_artifacts",
                "--parallel"
            ],
            "dependsOn": "Configure GCC Debug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Rebuild GCC Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-gcc",
                "--target",
                "X_Track_artifacts",
                "--clean-first",
                "--parallel"
            ],
            "dependsOn": "Configure GCC Debug",
            "problemMatcher": []
        },
        {
            "label": "Clean GCC Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build-gcc",
                "--target",
                "clean"
            ],
            "dependsOn": "Configure GCC Debug",
            "problemMatcher": []
        },
        {
            "label": "Configure GCC Release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build-gcc-release",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "problemMatcher": []
        },
