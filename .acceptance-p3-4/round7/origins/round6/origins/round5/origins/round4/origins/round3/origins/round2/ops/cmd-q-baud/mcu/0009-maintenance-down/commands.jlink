exec DisableAutoUpdateFW
exec SetRestartOnClose = 0
exec InhibitConnectRetries = 1
exec SetEnableMemCache = 0
connect
exec ExcludeFlashCacheRange 0x08000000-0x080FFFFF
w1 0x200535F7, 0x70
w1 0x200535F8, 0x72
w1 0x200535F9, 0x6F
w1 0x200535FA, 0x62
w1 0x200535FB, 0x65
w1 0x200535FC, 0x20
w1 0x200535FD, 0x30
w1 0x200535FE, 0x20
w1 0x200535FF, 0x39
w1 0x200535F0, 0x32
w1 0x200535F1, 0x31
w1 0x200535F2, 0x36
w1 0x200535F3, 0x30
w1 0x200535F4, 0x30
w1 0x200535F5, 0x0A
w4 0x20053A6C, 0x00000006
sleep 50
qc
